#!/usr/bin/env bash
# Launcher of a packaged Voxelith: the C++ runtime lives in lib/ next to the package, the shaders next to bin/voxelith.
# Run it from the package folder (projects/ and docs/ are relative to it). Windowed: DISPLAY must point at an X server (for streaming see docs/HANDOVER.md); headless: ./voxelith --headless --screenshot out.png
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export LD_LIBRARY_PATH="$DIR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$DIR/bin/voxelith" "$@"
